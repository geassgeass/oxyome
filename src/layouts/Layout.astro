---
interface Props {
    title?: string;
}

const { title = "OxyOme | Better Air, Better Life" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    </head>
    <body>
        <!-- 1. Floating Air Particles Background Effect -->
        <div class="particles-wrapper">
            <canvas id="air-particles"></canvas>
        </div>

        <slot />

        <!-- 2. Particle Animation Script -->
        <script>
            const canvas = document.getElementById('air-particles') as HTMLCanvasElement;
            if (canvas) {
                const ctx = canvas.getContext('2d');
                let width: number, height: number;
                let particles: DustParticle[] = [];

                const particleCount = 40; // Number of dust specks

                function resize() {
                    width = canvas.width = window.innerWidth;
                    height = canvas.height = window.innerHeight;
                }

                class DustParticle {
                    x: number = 0;
                    y: number = 0;
                    size: number = 0;
                    speedX: number = 0;
                    speedY: number = 0;
                    opacity: number = 0;

                    constructor() {
                        this.reset();
                    }

                    reset() {
                        this.x = Math.random() * width;
                        this.y = Math.random() * height;
                        this.size = Math.random() * 2 + 1.8; // Slightly larger base size (1.8px to 3.8px)
                        this.speedX = (Math.random() - 0.5) * 0.45; // Slightly faster side-to-side drift
                        this.speedY = -Math.random() * 0.55 - 0.25; // Slightly faster upward float
                        this.opacity = Math.random() * 0.4 + 0.25;  // Slightly more apparent/opaque
                    }

                    update() {
                        this.x += this.speedX;
                        this.y += this.speedY;

                        // Respawn particle if it floats past the top or sides
                        if (this.y < -10 || this.x < -10 || this.x > width + 10) {
                            this.reset();
                            this.y = height + 10;
                        }
                    }

                    draw() {
                        if (!ctx) return;
                        ctx.beginPath();
                        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                        // Warm amber/gold tint matching Airthings aesthetic
                        ctx.fillStyle = `rgba(217, 165, 32, ${this.opacity})`;
                        ctx.fill();
                    }
                }

                function initParticles() {
                    particles = [];
                    for (let i = 0; i < particleCount; i++) {
                        particles.push(new DustParticle());
                    }
                }

                function animate() {
                    if (!ctx) return;
                    ctx.clearRect(0, 0, width, height);
                    
                    particles.forEach(particle => {
                        particle.update();
                        particle.draw();
                    });

                    requestAnimationFrame(animate);
                }

                window.addEventListener('resize', resize);
                resize();
                initParticles();
                animate();
            }
        </script>
    </body>
</html>

<style is:global>
    :root {
        --font-heading: 'Playfair Display', Georgia, serif;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
        background-color: #ffffff;
        color: #0f172a;
        font-family: var(--font-sans);
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        position: relative;
    }

    /* 3. Canvas Container Styles (Sits cleanly in the background) */
    .particles-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none; /* Allows clicks to pass right through to your buttons/nav */
        z-index: -1;          /* Forces it behind all other elements */
        overflow: hidden;
    }

    #air-particles {
        display: block;
        width: 100%;
        height: 100%;
    }

    /* Apply the editorial serif look to main section headings */
    h1, h2, .hero-content h1, .section-title h2, .contact-container h2 {
        font-family: var(--font-heading);
        letter-spacing: -0.01em;
    }

    /* Keep UI elements, buttons, and navigation crisp in sans-serif */
    nav, button, input, textarea, .badge-pill, .brand-subtitle, .nav-links-centered a {
        font-family: var(--font-sans);
    }
</style>